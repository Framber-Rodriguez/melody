# Backend only. Never add actual credentials to GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional read-only GitHub metadata integration.
GITHUB_TOKEN=
GITHUB_REPOSITORIES=Framber-Rodriguez/melody
# Standalone backend. Keep HOST at loopback for local use.
HOST=127.0.0.1
PORT=8787
# Required for a remotely reachable backend (24+ characters).
MELODY_ACCESS_TOKEN=
# Exact frontend origins, comma separated; no wildcard.
ALLOWED_ORIGINS=https://framber-rodriguez.github.io
